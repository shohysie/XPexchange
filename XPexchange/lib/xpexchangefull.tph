//需要记录：kit（含基础职业）名称对应字符串，用于对话显示；kit.ids中的数值或名称，用于AddKit()；同时还需要能分基础职业种类进行调用
//kitlist.2da和kit.ids的宗派名称和数值严格对应，但没有基础职业描述。简单起见，基础职业不放入表格，仅读取kitlist.2da
COPY_EXISTING ~kitlist.2da~ ~override~
	COUNT_2DA_ROWS 9 kitsmax
	FOR (kitrow = 2 ; kitrow < kitsmax + 1 ; ++kitrow) BEGIN
		READ_2DA_ENTRY kitrow 1 9 kitname
		READ_2DA_ENTRY kitrow 2 9 lowername
		READ_2DA_ENTRY kitrow 8 9 classid
		//前面直接读kitlist.2da即可，后面读kit.ids
		PATCH_IF kitrow < 40 THEN BEGIN
			READ_2DA_ENTRY kitrow 9 9 kitid
			SET kitid = kitid + 1
			SET kitid = kitid - 1
			PATCH_IF classid == 1 THEN BEGIN SET $magekit(~%kitid%~) = lowername END
			PATCH_IF classid == 2 THEN BEGIN SET $fighterkit(~%kitid%~) = lowername END
			PATCH_IF classid == 3 THEN BEGIN SET $clerickit(~%kitid%~) = lowername END
			PATCH_IF classid == 4 THEN BEGIN SET $thiefkit(~%kitid%~) = lowername END
			PATCH_IF classid == 5 THEN BEGIN SET $bardkit(~%kitid%~) = lowername END
			PATCH_IF classid == 6 THEN BEGIN SET $paladinkit(~%kitid%~) = lowername END
			PATCH_IF classid == 11 THEN BEGIN SET $druidkit(~%kitid%~) = lowername END
			PATCH_IF classid == 12 THEN BEGIN SET $rangerkit(~%kitid%~) = lowername END
			PATCH_IF classid == 19 THEN BEGIN SET $sorcererkit(~%kitid%~) = lowername END
			PATCH_IF classid == 20 THEN BEGIN SET $monkkit(~%kitid%~) = lowername END
			PATCH_IF classid == 21 THEN BEGIN SET $shamankit(~%kitid%~) = lowername END
		END ELSE BEGIN
			INNER_ACTION BEGIN 
				COPY_EXISTING ~kit.ids~ ~override~
					COUNT_2DA_ROWS 2 kitidmax
					FOR (kitidrow = 1 ; kitidrow < kitidmax + 1 ; ++kitidrow) BEGIN
						READ_2DA_ENTRY kitidrow 0 2 kitid
						READ_2DA_ENTRY kitidrow 1 2 kitidname
						SET kitid = kitid + 1
						SET kitid = kitid - 1
						PATCH_IF ~%kitidname%~ STRING_EQUAL_CASE ~%kitname%~ THEN BEGIN
							PATCH_IF classid == 1 THEN BEGIN SET $magekit(~%kitid%~) = lowername END
							PATCH_IF classid == 2 THEN BEGIN SET $fighterkit(~%kitid%~) = lowername END
							PATCH_IF classid == 3 THEN BEGIN SET $clerickit(~%kitid%~) = lowername END
							PATCH_IF classid == 4 THEN BEGIN SET $thiefkit(~%kitid%~) = lowername END
							PATCH_IF classid == 5 THEN BEGIN SET $bardkit(~%kitid%~) = lowername END
							PATCH_IF classid == 6 THEN BEGIN SET $paladinkit(~%kitid%~) = lowername END
							PATCH_IF classid == 11 THEN BEGIN SET $druidkit(~%kitid%~) = lowername END
							PATCH_IF classid == 12 THEN BEGIN SET $rangerkit(~%kitid%~) = lowername END
							PATCH_IF classid == 19 THEN BEGIN SET $sorcererkit(~%kitid%~) = lowername END
							PATCH_IF classid == 20 THEN BEGIN SET $monkkit(~%kitid%~) = lowername END
							PATCH_IF classid == 21 THEN BEGIN SET $shamankit(~%kitid%~) = lowername END
						END
					END
				BUT_ONLY
			END
		END
	END
BUT_ONLY

